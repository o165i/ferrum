# Postgres connection string used by Prisma
DATABASE_URL="postgresql://ferrum:ferrum@db:5432/ferrum?schema=public"

# Auth.js
# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"
LOG_LEVEL="info"

# Bank transfer details shown after a successful bank-transfer order.
# These defaults are test-only and must be replaced before launch.
BANK_TRANSFER_ACCOUNT_HOLDER="FERRUM Demo Store"
BANK_TRANSFER_BANK_NAME="Demo Bank (test details)"
BANK_TRANSFER_IBAN="DE00 0000 0000 0000 0000 00"
BANK_TRANSFER_BIC="TESTDE00XXX"

# PayPal preparation. Real checkout remains disabled until merchant credentials
# are added and the server-side create/capture flow is enabled.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
